# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# generated by sync-template.mjs before publishing — do not commit
/create-ux-prototype/template

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local credentials and secret-bearing files — never commit
/passwords/
/secrets/
/credentials/
/passwords.*
/secrets.*
/tokens.*
/api-keys.*
/api_keys.*
*.key
*.p12
*.pfx
*.token
*.secret
*.credentials

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
